[gd_scene format=3 uid="uid://bw3igxjeniikh"]

[sub_resource type="GDScript" id="GDScript_sddv5"]
script/source = "extends Node2D
class_name RhythmReceptor
@export_range(0, 3) var lane: int = 0

var is_active: bool = false

var ARROW_POINTS := PackedVector2Array([
	Vector2(0, -28),
	Vector2(23, -5),
	Vector2(11, -5),
	Vector2(11, 22),
	Vector2(-11, 22),
	Vector2(-11, -5),
	Vector2(-23, -5)
])

const LANE_ANGLES := [
	-PI / 2.0,
	PI,
	0.0,
	PI / 2.0
]

const LANE_COLORS := [
	Color(\"#38bdf8\"),
	Color(\"#a78bfa\"),
	Color(\"#4ade80\"),
	Color(\"#fb7185\")
]


func _ready() -> void:
	queue_redraw()


func set_active(active: bool) -> void:
	is_active = active
	queue_redraw()


func _draw() -> void:
	var points := PackedVector2Array()

	for point in ARROW_POINTS:
		points.append(point.rotated(LANE_ANGLES[lane]))

	var color: Color = LANE_COLORS[lane]

	# Fundo escuro.
	draw_circle(Vector2.ZERO, 38.0, Color(\"#111827\"))

	# A seta fica mais clara quando pressionada.
	var alpha := 1.0 if is_active else 0.55
	color.a = alpha

	draw_colored_polygon(points, color)

	if is_active:
		draw_arc(
			Vector2.ZERO,
			42.0,
			0.0,
			TAU,
			48,
			Color.WHITE,
			3.0
		)
"

[node name="Node2D" type="Node2D" unique_id=764158175]
script = SubResource("GDScript_sddv5")

